<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.*?>
<fx:root type="javafx.stage.Stage" xmlns:fx="http://javafx.com/fxml/1"
         title="Scoutly" minWidth="760" minHeight="700" onCloseRequest="#handleExit">
  <icons><Image url="@/images/address_book_32.png" /></icons>
  <scene>
    <Scene>
      <stylesheets><URL value="@Workspace.css" /></stylesheets>
      <VBox styleClass="workspace" spacing="12">
        <MenuBar VBox.vgrow="NEVER">
          <Menu mnemonicParsing="false" text="File">
            <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <MenuItem fx:id="helpMenuItem" mnemonicParsing="false" onAction="#handleHelp" text="Command reference" />
          </Menu>
        </MenuBar>
        <HBox styleClass="brand-bar"><Label text="Scoutly" styleClass="brand-title" /></HBox>
        <StackPane fx:id="dashboardPlaceholder" styleClass="workspace-inset" />
        <SplitPane dividerPositions="0.42" VBox.vgrow="ALWAYS" styleClass="workspace-inset">
          <StackPane fx:id="personListPanelPlaceholder" minWidth="280" />
          <StackPane fx:id="profilePlaceholder" minWidth="280" />
        </SplitPane>
        <StackPane fx:id="resultDisplayPlaceholder" minHeight="64" prefHeight="80" maxHeight="110"
                   styleClass="workspace-inset" />
        <StackPane fx:id="commandBoxPlaceholder" styleClass="workspace-inset" />
        <StackPane fx:id="statusbarPlaceholder" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
