<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.*?>
<fx:root type="javafx.stage.Stage" xmlns:fx="http://javafx.com/fxml/1"
         title="Scoutly" minWidth="760" minHeight="700" onCloseRequest="#handleExit">
  <icons><Image url="@/images/address_book_32.png" /></icons>
  <scene>
    <Scene>
      <stylesheets><URL value="@Workspace.css" /></stylesheets>
      <VBox styleClass="workspace" spacing="6">
        <MenuBar VBox.vgrow="NEVER">
          <Menu mnemonicParsing="false" text="File">
            <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <MenuItem fx:id="helpMenuItem" mnemonicParsing="false" onAction="#handleHelp" text="Command reference" />
          </Menu>
        </MenuBar>
        <HBox styleClass="brand-bar"><Label text="Scoutly" styleClass="brand-title" /></HBox>
        <!-- Keep controls at their natural height. Scroll the workspace on small windows
             instead of allowing its children to overlap; command input remains outside. -->
        <ScrollPane fx:id="workspaceScroll" fitToWidth="true" fitToHeight="true"
                    hbarPolicy="NEVER" minHeight="0" VBox.vgrow="ALWAYS">
          <VBox spacing="6">
            <StackPane fx:id="dashboardPlaceholder" minHeight="-Infinity" maxHeight="-Infinity"
                       styleClass="workspace-inset" />
            <StackPane fx:id="workspaceToolbarPlaceholder" minHeight="-Infinity" maxHeight="-Infinity"
                       styleClass="workspace-inset" />
            <SplitPane dividerPositions="0.42" minHeight="260" VBox.vgrow="ALWAYS" styleClass="workspace-inset">
              <StackPane fx:id="personListPanelPlaceholder" minWidth="280" minHeight="240" />
              <StackPane fx:id="profilePlaceholder" minWidth="280" minHeight="240" />
            </SplitPane>
          </VBox>
        </ScrollPane>
        <StackPane fx:id="resultDisplayPlaceholder" minHeight="42" prefHeight="48" maxHeight="72"
                   styleClass="workspace-inset" />
        <StackPane fx:id="commandBoxPlaceholder" styleClass="workspace-inset" />
        <StackPane fx:id="statusbarPlaceholder" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
