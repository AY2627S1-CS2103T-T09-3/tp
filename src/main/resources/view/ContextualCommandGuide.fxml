<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="guideContainer" spacing="4.0" styleClass="command-guide"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets bottom="7.0" left="10.0" right="10.0" top="7.0" />
  </padding>
  <Label fx:id="guideTitle" styleClass="command-guide-title" text="Command guide" />
  <TextArea fx:id="guideText" editable="false" focusTraversable="false"
            styleClass="command-guide-text" wrapText="true" VBox.vgrow="ALWAYS" />
</VBox>
