<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<fx:root type="javafx.stage.Stage" title="Scoutly command reference" minWidth="760" minHeight="500"
         width="900" height="580" xmlns:fx="http://javafx.com/fxml/1">
  <scene>
    <Scene>
      <stylesheets><URL value="@Workspace.css" /></stylesheets>
      <VBox spacing="14" styleClass="help-body">
        <Label text="Command reference" styleClass="workspace-title" />
        <TextField fx:id="helpSearch" promptText="Search commands, descriptions, or syntax…"
                   accessibleText="Search command reference" />
        <SplitPane dividerPositions="0.36" VBox.vgrow="ALWAYS">
          <ListView fx:id="commandEntries" minWidth="180" />
          <VBox spacing="12" styleClass="surface" minWidth="300">
            <Label fx:id="commandTitle" wrapText="true" styleClass="section-title" />
            <TextArea fx:id="commandUsage" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
            <Button fx:id="insertTemplate" text="Insert template" onAction="#handleInsertTemplate" />
          </VBox>
        </SplitPane>
        <Label fx:id="helpStatus" wrapText="true" styleClass="muted" />
        <Button text="Copy online user guide link" onAction="#copyUrl" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
